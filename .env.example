# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# Keys only: leave a value empty (or delete the line) to use the default shown in brackets.
# Defaults live in src/app/config.py.

# URL of the Ollama server. [http://localhost:11434]
OLLAMA_HOST=

# Model preselected in the UI. One of the registry tags: gemma4:e2b (fast), gemma4:e4b
# (standard). An unknown tag falls back to the fast model. [gemma4:e2b]
DEFAULT_MODEL=

# Target language preselected in the UI, as ISO code: de, en, fr, es, it, pt, nl, pl, cs. [en]
DEFAULT_TARGET_LANG=

# Maximum characters of text sent to the model per request. Smaller = more requests but safer
# for small models. Whole number > 0. [per model: see src/app/models.py]
SEGMENT_CHARS=

# Largest accepted upload in MB. Whole number > 0. [25]
MAX_UPLOAD_MB=

# Seconds to wait for one model answer before the segment fails. Number > 0. [600]
LLM_TIMEOUT_S=

# First-run passwords for the accounts "T. Hein" and "Gast". Hashed into data/users.json on the
# first start; later changes here have no effect (delete data/users.json to re-seed).
# At least one is required on the first start.
SEED_PW_HEIN=
SEED_PW_GAST=

# Comma-separated user names that see the "App beenden" button. [T. Hein]
ADMIN_USERS=

# Folder for runtime data (users.json). Absolute path or relative to the working directory.
# [<repo>/data]
DATA_DIR=
